# 教培机构物资管理系统 - 环境变量配置模板
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# 服务端口
SERVER_PORT=8080

# 数据库路径
DB_PATH=./data/school.db

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET=your-secret-key
JWT_EXPIRE_HOUR=24

# 跨域允许的前端地址
CORS_ORIGINS=http://localhost:5173

# 种子数据：默认总部校区名称
SEED_HQ_NAME=总部

# 种子数据：默认总部管理员
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
